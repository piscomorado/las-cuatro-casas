{
  "name": "las-cuatro-casas",
  "private": true,
  "version": "0.0.0",
  "description": "Las Cuatro Casas — juego de estrategia abstracta digital para 2-4 jugadores",
  "scripts": {
    "build": "pnpm --filter=@lcch/engine build && pnpm --filter=@lcch/shared build && pnpm --filter=@lcch/web build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "simulate": "pnpm --filter=@lcch/engine simulate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
